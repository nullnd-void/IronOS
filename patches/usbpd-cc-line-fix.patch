+struct FusbDiag {
+  volatile uint8_t  listenOnly;
+  volatile uint8_t  devId;      // FUSB_DEVICE_ID register
+  volatile uint8_t  cc1;        // BC_LVL measured on CC1
+  volatile uint8_t  cc2;        // BC_LVL measured on CC2
+  volatile uint8_t  irqA;       // OR of every INTERRUPTA value seen
+  volatile uint8_t  irqB;       // OR of every INTERRUPTB value seen
+  volatile uint8_t  irq;        // OR of every INTERRUPT value seen
+  volatile uint8_t  rxGood;     // messages read from the FIFO with an SOP token
+  volatile uint8_t  rxBad;      // FIFO entries that were not SOP
+  volatile uint8_t  statusFail; // failed status reads (I2C)
+  volatile uint16_t lastHdr;    // header of the last SOP message
+  volatile uint16_t lastTxHdr;  // header of the last message we transmitted
+  volatile uint8_t  txCount;    // number of messages handed to the TX FIFO
+  volatile uint8_t  txFail;     // bit0/1/2: I2C write of SOP / message / EOP part failed
+};
+extern FusbDiag fusbDiag;
